    {
      "name": "Órdenes",
      "description": "Correr en orden (Runner). Usa el usuario {{userId}}; empieza ingresando pesos.",
      "item": [
        {
          "name": "1. Ingreso de pesos (CASH_IN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"instrumentId\": {{arsId}},\n  \"side\": \"CASH_IN\",\n  \"type\": \"MARKET\",\n  \"size\": 100000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('FILLED', () => pm.expect(pm.response.json().status).to.eql('FILLED'));"
                ]
              }
            }
          ]
        },
