            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('encuentra PAMP', () => pm.expect(pm.response.json().map(i => i.ticker)).to.include('PAMP'));",
                  "pm.test('cacheable', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('max-age'));"
                ]
              }
