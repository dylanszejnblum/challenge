{
  "info": {
    "name": "Cocos challenge API",
    "description": "Colección para probar la API. Levantar con `docker compose up --build` y correr con el Runner (o `newman run`). Si la API no está en el 3000, cambiar `baseUrl` en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "200 si la API llega a Postgres, 503 si no."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('database up', () => pm.expect(pm.response.json().database).to.eql('up'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
